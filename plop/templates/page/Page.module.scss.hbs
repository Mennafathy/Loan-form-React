@use '@/styles/abstracts/variables' as *;
@use '@/styles/abstracts/mixins' as *;

.page {
  padding: $spacing-xl;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.header {
  margin-bottom: $spacing-xl;
}

.title {
  font-size: 2.25rem;
  margin-bottom: $spacing-xs;
  color: $color-text-main;
}

.subtitle {
  color: $color-text-muted;
}

.content {
  display: flex;
  flex-direction: column;
  gap: $spacing-lg;
}
